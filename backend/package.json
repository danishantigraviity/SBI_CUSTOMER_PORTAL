{
  "name": "sbi-cc-backend",
  "version": "2.0.0",
  "description": "SBI Credit Card Onboarding System — Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node config/seed.js",
    "sync-sheets": "node scripts/syncSheets.js",
    "clear-sheet": "node scripts/clearSheet.js",
    "build": "cd ../frontend && npm install && npm run build && node -e \"const fs = require('fs'); fs.cpSync('./build', '../backend/build', { recursive: true });\"",
    "postinstall": "cd ../frontend && npm install && npm run build && node -e \"const fs = require('fs'); fs.cpSync('./build', '../backend/build', { recursive: true });\"",
    "test": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.14.0",
    "socket.io": "^4.8.3",
    "twilio": "^4.20.0",
    "uuid": "^14.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
